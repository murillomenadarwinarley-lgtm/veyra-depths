config_version=5

[application]

config/name="Veyra Depths"
run/main_scene="res://Core/main.tscn"
config/description="Metroidvania 2D estilo Silksong. Estructura de proyecto: Core, Player, World, Entities, Systems, UI."
config/icon="res://icon.svg"

[autoload]

Audio="*res://Systems/audio/audio_manager.gd"
